# Public address. Use a domain for automatic HTTPS, for example: lims.example.com
# For an IP-only deployment without TLS use: http://203.0.113.10
APP_ADDRESS=lims.example.com
APP_ORIGIN=https://lims.example.com

# Database credentials. Keep the password URL-safe (hex is recommended).
POSTGRES_DB=galvano_lims
POSTGRES_USER=galvano
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX

# Generate each value independently with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_128_CHAR_RANDOM_HEX
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_128_CHAR_RANDOM_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# GUS BIR production integration
GUS_ENABLED=true
GUS_BIR_URL=https://wyszukiwarkaregon.stat.gov.pl/wsBIR/UslugaBIRzewnPubl.svc
GUS_BIR_KEY=REPLACE_WITH_GUS_KEY
GUS_TIMEOUT_MS=12000

# Optional SMTP settings. Leave blank when email is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
